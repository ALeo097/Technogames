{
    "name": "technogames/tienda",
    "description": "Tienda de videojuegos con MongoDB",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-mongodb": "*",
        "mongodb/mongodb": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
